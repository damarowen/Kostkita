<%- include ('../partials/header')  %>

<div class="container container-form">
  <h1 class="text-center">Change Password</h1>

  <form class="validated-form" action="/users/<%= user._id %>/password?_method=PUT" method="POST" novalidate>
    <div class="form-group">
      <label for="currentPassword">Current Password</label>
      <input class="form-control" type="password" name="changePassword[currentPassword]" required>
    </div>
    <div class="form-group">
      <label for="newPassword">New Password</label>
      <input class="form-control" type="password" name="changePassword[newPassword]" minlength="8" required>
      <small class="form-text text-muted">At least 8 characters, include letters and numbers.</small>
    </div>
    <div class="form-group">
      <label for="confirmPassword">Confirm New Password</label>
      <input class="form-control" type="password" name="changePassword[confirmPassword]" minlength="8" required>
    </div>
    <button class="btn btn-lg btn-pink btn-block">Update Password</button>
    <a href="/users/<%= user._id %>/edit" class="btn btn-link">Back to Edit Profile</a>
  </form>
</div>

<%- include ('../partials/footer')  %>
